<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Catálogo, pedidos y servicio técnico -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Avisos de estado de pedido (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Preferencia "Biometría" del perfil; la app no bloquea el arranque -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Feedback táctil en carrito y panel -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      NO se piden:
      · CAMERA: no hay escaneo de QR en el prototipo.
      · READ_MEDIA_IMAGES: el arte es vectorial; no se suben fotos.
      · ACCESS_FINE_LOCATION: la dirección se escribe a mano.
      Si se agrega pago con QR o fotos de reparación, pedirlas en el momento
      de uso y explicar para qué.
    -->

    <application
        android:name=".MegaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MegaTechnology">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MegaTechnology">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: mega://product/p1, mega://orders, mega://admin -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mega" android:host="product" />
                <data android:scheme="mega" android:host="orders" />
                <data android:scheme="mega" android:host="admin" />
            </intent-filter>
        </activity>
    </application>
</manifest>
